---
import BaseLayout from "./BaseLayout.astro";
import { LIUBAI_LINKS, LIUBAI_NAME, LIUBAI_NAME_EN } from "../consts";

interface Props {
  /** Markdown 页面通过 layout frontmatter 注入 */
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { title, description } = Astro.props.frontmatter;

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title={`${title} · ${LIUBAI_NAME}`}
  description={description}
  type="article"
>
  <div class="container">
    <div class="bg-text" aria-hidden="true">{LIUBAI_NAME}</div>
    <header>
      <a href={`${base}liubai`} class="brand">{LIUBAI_NAME}</a>
    </header>
    <article>
      <h1>{title}</h1>
      <slot />
    </article>
    <footer>
      <nav aria-label="留白 相关页面">
        {
          LIUBAI_LINKS.map(({ path, label }) => (
            <a href={`${base}${path}`}>{label}</a>
          ))
        }
      </nav>
      <p class="copyright">
        &copy; {new Date().getFullYear()} {LIUBAI_NAME_EN}. All rights reserved.
      </p>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  /* 留白用暖白底，区别于站点默认的纯白。样式只随本布局的页面下发 */
  body {
    background: #fafaf8;
  }
</style>

<style>
  .container {
    max-width: 640px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 3rem;
    position: relative;
    overflow: hidden;
    line-height: 1.75;
  }

  .bg-text {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-serif-sc);
    font-size: clamp(5rem, 16vw, 14rem);
    font-weight: 700;
    letter-spacing: 0.15em;
    color: rgba(0, 0, 0, 0.025);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  header {
    position: relative;
    z-index: 1;
    margin-bottom: 2rem;
  }

  .brand {
    font-family: var(--font-serif-sc);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #333;
  }

  .brand:hover {
    color: #000;
  }

  article {
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: var(--font-serif-sc);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #1a1a1a;
  }

  article :global(h2) {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #333;
  }

  article :global(h3) {
    font-size: 1rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: #444;
  }

  article :global(p) {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
  }

  article :global(ul),
  article :global(ol) {
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }

  article :global(li) {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.35rem;
  }

  article :global(a) {
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  article :global(a:hover) {
    color: #000;
  }

  article :global(strong) {
    font-weight: 600;
    color: #333;
  }

  footer {
    position: relative;
    z-index: 1;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    text-align: center;
  }

  footer nav {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-bottom: 1rem;
    font-size: 0.85rem;
  }

  footer nav a {
    color: var(--color-text-tertiary);
  }

  footer nav a:hover {
    color: #333;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--color-text-tertiary);
  }
</style>
