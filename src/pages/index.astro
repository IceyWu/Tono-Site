---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tono">
  <div class="page">
    <div class="bg-text" aria-hidden="true">Tono</div>
    <div class="gradient-blur" aria-hidden="true"></div>

    <main>
      <h1>Tono</h1>
      <p class="subtitle">Simple &middot; Powerful &middot; Yours</p>
      <p class="desc">专注创造，让工具回归本质</p>
    </main>

    <footer>
      <p class="copyright">
        &copy; {new Date().getFullYear()} Tono. All rights reserved.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  /* ── Background watermark ── */
  .bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: "Playfair Display", serif;
    font-size: clamp(6rem, 18vw, 16rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgba(0, 0, 0, 0.025);
    white-space: nowrap;
    pointer-events: none;
    user-select: none;
  }

  /* ── Subtle gradient accent ── */
  .gradient-blur {
    position: absolute;
    top: -10%;
    right: -5%;
    width: 300px;
    height: 400px;
    background:
      radial-gradient(
        ellipse 60% 50% at 30% 40%,
        rgba(130, 120, 255, 0.35) 0%,
        transparent 55%
      ),
      radial-gradient(
        ellipse 50% 50% at 65% 55%,
        rgba(255, 170, 140, 0.25) 0%,
        transparent 55%
      ),
      radial-gradient(
        ellipse 40% 40% at 50% 70%,
        rgba(140, 200, 255, 0.2) 0%,
        transparent 55%
      );
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }

  /* ── Main ── */
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: "Playfair Display", serif;
    font-size: clamp(3.5rem, 10vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #111;
  }

  .subtitle {
    margin-top: 0.75rem;
    font-size: 1rem;
    color: #999;
    letter-spacing: 0.08em;
    font-weight: 400;
  }

  .desc {
    margin-top: 0.5rem;
    font-size: 0.9375rem;
    color: #bbb;
  }

  /* ── Footer ── */
  footer {
    padding: 2rem 0;
    position: relative;
    z-index: 1;
  }

  .copyright {
    font-size: 0.8125rem;
    color: #ccc;
  }
</style>
