---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Tono">
  <div class="page">
    <main>
      <h1 class="logo">Tono</h1>
      <p class="tagline">Simple. Powerful. Yours.</p>
    </main>

    <footer>
      <p class="copyright">
        © {new Date().getFullYear()} Tono. All rights reserved.
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem;
    text-align: center;
  }

  main {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  .logo {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #111;
  }

  .tagline {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    color: #666;
    font-weight: 400;
  }

  footer {
    padding: 2rem 0;
    color: #999;
    font-size: 0.875rem;
  }
</style>
