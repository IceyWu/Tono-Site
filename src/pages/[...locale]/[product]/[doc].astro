---
/**
 * 产品文档页：产出 /liubai/privacy、/en/liubai/privacy 等。
 *
 * 文档条目以默认语言为准枚举，因此某语言缺译时链接不会断 ——
 * 那一页渲染默认语言的正文并标为 noindex（见 resolveDoc 的 translated）。
 */
import ProductDocLayout from "../../../layouts/ProductDocLayout.astro";
import { LOCALES, localeParam, localeUrl, type Locale } from "../../../i18n";
import {
  docSlugsOf,
  getDocs,
  getProducts,
  resolveDoc,
  type Doc,
  type Product,
} from "../../../lib/catalog";
import { render } from "astro:content";

export async function getStaticPaths() {
  const [products, docs] = await Promise.all([getProducts(), getDocs()]);

  return LOCALES.flatMap((locale) =>
    products.flatMap((product) => {
      const slugs = docSlugsOf(docs, product.id);

      return slugs.flatMap((slug) => {
        const resolved = resolveDoc(docs, product.id, locale, slug);
        if (!resolved) return [];

        return [
          {
            params: { locale: localeParam(locale), product: product.id, doc: slug },
            props: {
              locale,
              product,
              docSlugs: slugs,
              entry: resolved.entry,
              translated: resolved.translated,
            },
          },
        ];
      });
    }),
  );
}

const { locale, product, docSlugs, entry, translated } = Astro.props as {
  locale: Locale;
  product: Product;
  docSlugs: string[];
  entry: Doc;
  translated: boolean;
};

const { Content } = await render(entry);
---

<ProductDocLayout
  locale={locale}
  product={product}
  docSlugs={docSlugs}
  title={entry.data.title}
  description={entry.data.description}
  image={localeUrl(
    locale,
    `${product.id}/${entry.id.split("/").at(-1)}/og.png`,
  ).replace(/\/$/, "")}
  updated={entry.data.updated}
  translated={translated}
>
  <Content />
</ProductDocLayout>
