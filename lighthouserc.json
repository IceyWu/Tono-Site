{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/liubai/", "http://localhost/en/liubai/", "http://localhost/liubai/privacy/"],
      "numberOfRuns": 1,
      "chromeFlags": "--headless --no-sandbox --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "network-dependency-tree-insight": "off",
        "forced-reflow-insight": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
